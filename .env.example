# =============================================================================
# NBFC Compliance AI — environment variables
# Copy to .env and fill in values for your deployment target.
# On ECS Fargate, set these in the task definition / Secrets Manager instead.
# =============================================================================

# -- Application --------------------------------------------------------------
APP_VERSION=1.0.0                         # Semantic version shown in /health
ENVIRONMENT=production                    # development | staging | production
ENV=production                            # Controls docs_url visibility
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=https://yourdomain.com       # Comma-separated allowed origins, or * for all

# -- AWS ----------------------------------------------------------------------
AWS_REGION=ap-south-1                     # Region for Bedrock + other AWS services
# On ECS the task role provides credentials — do NOT set keys here.
# AWS_ACCESS_KEY_ID=                      # Only for local development
# AWS_SECRET_ACCESS_KEY=                  # Only for local development

# -- Bedrock LLM --------------------------------------------------------------
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_RETRIES=3                     # Max retry attempts for invoke_model
BEDROCK_TIMEOUT_SECONDS=30                # Per-call timeout

# -- FAISS Index ---------------------------------------------------------------
INDEX_MASTER_PATH=ingestion/data/indexes/master_index
INDEX_UPDATED_PATH=ingestion/data/indexes/updated_index

# -- RAG Pipeline Settings (ingestion/config.py) -------------------------------
RAW_DATA_DIR=ingestion/data/raw/
CLEANED_DATA_DIR=ingestion/data/cleaned/
INDEX_DIR=ingestion/data/indexes/
MASTER_INDEX_NAME=master_index
UPDATED_INDEX_NAME=updated_index
CHUNK_SIZE=512
CHUNK_OVERLAP=64
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5

# -- Sanctions -----------------------------------------------------------------
SANCTIONS_LIST_PATH=ingestion/data/sanctions.json

# -- Reviewer / Admin Routes ---------------------------------------------------
REVIEWER_API_KEY=replace-with-a-long-random-string

# -- Backend Tables ------------------------------------------------------------
COMPLIANCE_RULES_TABLE=nbfc-compliance-rules
COMPLIANCE_CHANGELOG_TABLE=nbfc-rule-changelog
FEEDBACK_TABLE=nbfc-feedback
CALIBRATION_REPORTS_TABLE=nbfc-calibration-reports
AUDIT_RECORDS_TABLE=nbfc-audit-records
AUDIT_CHAIN_TABLE=nbfc-audit-chain
AUDIT_SEQUENCE_TABLE=nbfc-audit-sequence

# -- Index Watcher / Hot Swap --------------------------------------------------
INDEX_S3_BUCKET=nbfc-compliance-indexes
INDEX_WATCH_PREFIX=indexes/
INDEX_LOCAL_CACHE_DIR=/tmp/faiss_cache/

# -- Embedder ------------------------------------------------------------------
EMBED_BATCH_SIZE=32                       # Batch size for sentence-transformers encoding
